# Copy to .env.production.local (ignored by Git); fill every required value.
CHURCH_DOMAIN=
APP_SECRET=
DATABASE_PASSWORD=
# Same database password, percent-encoded for DATABASE_URL.
DATABASE_PASSWORD_URLENCODED=
DATABASE_MIGRATION_PASSWORD=
JWT_PASSPHRASE=
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
RELEASE_TAG=pilot-1
# Configure verified provider credentials before actual delivery is enabled.
MAILER_DSN=null://null
MAILER_FROM=noreply@example.invalid
SMS_API_URL=
SMS_API_TOKEN=

# Hosted ZAR payments: supply credentials only in the private production environment.
PAYMENTS_PUBLIC_URL=
PAYFAST_MODE=test
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_ITN_IP_RANGES=197.97.145.144/28,41.74.179.192/27,102.216.36.0/28,102.216.36.128/28,144.126.193.139/32
YOCO_MODE=test
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
