# Copy to ignored .env.java-production.local. This contains paths, not secrets.
# For an Ubuntu host with Nginx and the frontend, export JAVA_PRODUCTION_TARGET=nginx-app
# in the operator shell/job; see docs/backend-cicd.md. API-only uses nginx-api.
RELEASE_TAG=replace-with-git-commit
CHURCH_DOMAIN=church.example.org
API_DOMAIN=api.church.example.org
SECRETS_DIR=/srv/holyspace/secrets
# Public, distinct origins for browser returns and provider callbacks.
PAYMENTS_PUBLIC_URL=https://church.example.org
PAYMENTS_BACKEND_URL=https://api.church.example.org
CORS_ALLOWED_ORIGINS=https://church.example.org
PEOPLE_TIME_ZONE=Africa/Johannesburg
SESSION_LIFETIME=8h
DB_POOL_SIZE=5
# Conservative runtime caps. Leave host RAM for Ubuntu, Docker and deployment work.
# A 1 GB host is tight; use at least 2 GB for production and measure under load.
API_MEMORY_LIMIT=512m
DATABASE_MEMORY_LIMIT=192m
MIGRATION_MEMORY_LIMIT=256m
WEB_MEMORY_LIMIT=48m
TOOLS_MEMORY_LIMIT=128m
HTTP_MAX_THREADS=32
# Keep outbound services disabled until production verification is approved.
EMAIL_ENABLED=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=
PUSH_ENABLED=false
PUSH_PROJECT_ID=
