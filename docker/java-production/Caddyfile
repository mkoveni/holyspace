{$CHURCH_DOMAIN} {
    request_body {
        max_size 6MiB
    }
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy web:8080 {
        header_up -Forwarded
        header_up -X-Forwarded-Port
        header_up -X-Forwarded-Prefix
    }
}
{$API_DOMAIN} {
    request_body {
        max_size 6MiB
    }
    header Strict-Transport-Security "max-age=31536000"
    @api path /api/*
    handle @api {
        reverse_proxy api:8082 {
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Forwarded-Prefix
        }
    }
    handle /health/ready {
        rewrite * /actuator/health/readiness
        reverse_proxy api:8082 {
            header_up -Forwarded
            header_up -X-Forwarded-Port
            header_up -X-Forwarded-Prefix
        }
    }
    handle {
        respond 404
    }
}
