# Native devices need a reachable HTTPS API origin. Android emulator local development: http://10.0.2.2:8082.
# This is public build configuration; never place provider credentials or server encryption keys here.
EXPO_PUBLIC_API_URL=http://localhost:8082

# Configure the public EAS project UUID after creating/linking the project.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local Android client configuration file supplied by Firebase, or an EAS file environment variable.
# Do not put FCM service-account keys here.
GOOGLE_SERVICES_JSON=
