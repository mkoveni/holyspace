# Production environment for the Symfony API.
#
# Copy to /srv/onechurch-api/shared/.env.local on the server (owner onechurch, mode 0640) and fill in every value.
# Each deploy compiles it into the release's .env.local.php (composer dump-env prod), so edit this file and redeploy
# (or run deploy/remote-install.sh --reconfigure) to change a value. Never commit the filled-in copy.

APP_ENV=prod
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=
# Persistent cache pools (scheduler state, rate limiters). Must survive releases.
APP_SHARE_DIR=/srv/onechurch-api/shared/var/share

# Uploaded images (Media context). Must survive releases and be backed up with the database.
MEDIA_STORAGE_PATH=/srv/onechurch-api/shared/media

# Public HTTPS origin of this API, used for URLs generated outside a request (console, worker).
DEFAULT_URI=https://api.church.example.org

# Exact frontend origins allowed to call /api (a regex). Example for one origin:
CORS_ALLOW_ORIGIN='^https://church\.example\.org$'

# Single host: file locks in a directory shared by PHP-FPM and the worker (the worker has a private /tmp).
LOCK_DSN=flock:///srv/onechurch-api/shared/var/lock

# PostgreSQL. Use a dedicated role that owns only this database. URL-encode special characters in the password.
DATABASE_URL="postgresql://onechurch:CHANGE_ME@127.0.0.1:5432/onechurch?serverVersion=16&charset=utf8"

# Sessions and password hashing.
SESSION_LIFETIME_SECONDS=28800
PASSWORD_HASH_COST=12
PEOPLE_TIME_ZONE=Africa/Johannesburg

# Email. Leave disabled until the SMTP relay and sender are verified.
MAILER_DSN=smtp://USER:PASS@smtp.example.org:587
COMMUNICATIONS_EMAIL_ENABLED=false
COMMUNICATIONS_EMAIL_CAPTURE=false
COMMUNICATIONS_EMAIL_FROM=

# Device push (Expo). PUSH_TOKEN_KEY: openssl rand -base64 32. If the Java backend already stored device tokens,
# reuse its key or those tokens become unreadable.
PUSH_ENABLED=false
PUSH_PROJECT_ID=
PUSH_TOKEN_KEY=
PUSH_EXPO_URL=https://exp.host/--/api/v2/push
PUSH_ACCESS_TOKEN=

# Payments. PAYMENTS_TOKEN_KEY: openssl rand -base64 32. It encrypts stored provider credentials and subscription tokens:
# if this database was used by the Java backend, it MUST be the Java deployment's key. Back it up; losing it is final.
PAYMENTS_PUBLIC_URL=https://church.example.org
PAYMENTS_BACKEND_URL=https://api.church.example.org
PAYMENTS_TOKEN_KEY=
# Public giving (/give) captcha: the Cloudflare Turnstile SECRET key. Required: with it empty, production refuses every
# public checkout. The matching public site key goes in frontend/.env.production as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
PAYFAST_MODE=test
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_ITN_IP_RANGES=197.97.145.144/28,41.74.179.192/27
YOCO_MODE=test
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
